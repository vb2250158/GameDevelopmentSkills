  "runtimeConstraints": {
    "targetLanguage": "zh-CN",
    "applyDuring": [
      "planning",
      "visible_reasoning",
      "commentary",
      "final",
      "documents"
    ],
    "checks": [
      {
        "id": "PM-001",
        "level": "error",
        "scope": [
          "commentary",
          "final",
          "documents"
        ],
        "kind": "forbidden_phrases",
        "values": [
          "先说结论",
          "一句话总结",
          "我用最直白的方式讲",
          "希望有帮助",
          "要不要我顺手"
        ],
        "message": "删除宣布表达方式或礼貌收尾的套话。"
      },
      {
        "id": "PM-002",
        "level": "error",
        "scope": [
          "commentary",
          "final",
          "documents"
        ],
        "kind": "unasked_negative_exclusion",
        "patterns": [
          "当前不等于",
          "不代表",
          "不能判定",
          "不能说明"
        ],
        "allowWhenPromptAsksBoundary": true,
        "message": "直接写实际状态；用户询问排除项时再回答排除项。"
      },
      {
        "id": "PM-003",
        "level": "error",
        "scope": [
          "final"
        ],
        "kind": "simple_answer_has_extra_sentences",
        "allowWhenPromptAsksReason": true,
        "message": "答案已经完整，删除后续解释。"
      },
      {
        "id": "PM-004",
        "level": "warning",
        "scope": [
          "commentary",
          "final",
          "documents"
        ],
        "kind": "duplicate_paragraph",
        "similarityThreshold": 0.72,
        "message": "后文重复前文信息，保留第一次表述。"
      },
      {
        "id": "PM-005",
        "level": "error",
        "scope": [
          "commentary",
          "final",
          "documents"
        ],
        "kind": "target_language",
        "language": "zh-CN",
        "message": "自然语言使用目标语言；代码、命令、路径、日志、标识符和精确引文除外。"
      },
      {
        "id": "PM-006",
        "level": "warning",
        "scope": ["commentary", "final", "documents"],
        "kind": "redundant_first_person_execution",
        "patterns": ["我会", "我将", "我正在", "接下来我"],
        "message": "执行者已由上下文确定，删除第一人称，直接写动作和结果。"
      }
    ]
  },
  "limitations": [
    "没有目标语料统计时，不得把规则写成统计结论。",
    "语义完整性和每段是否确有新信息仍需生成阶段判断；Hook 只报告能够确定的错误。"
  ],
  "targetParameterPolicy": {
    "frequencyPolicy": "null_when_not_measured",
    "runtimeSource": "runtimeConstraints.checks"
  }
}
